# Local .terraform directories
**/.terraform/*

# Terraform state files - never commit these, they can contain sensitive data
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Real variable values - commit terraform.tfvars.example instead
terraform.tfvars
*.auto.tfvars

# CLI config files
.terraformrc
terraform.rc

# tfplan
*tfplan